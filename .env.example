# Team Reveille - Environment Variables Template
# Copy to .env.development or .env.production and fill in values

# AWS (for local development / Serverless deployment)
AWS_REGION=us-east-1

# Cognito (for JWT verification)
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# DynamoDB (auto-set by Serverless for Lambda; needed for local testing)
# STUDENT_PROFILES_TABLE=StudentProfiles-${sls:stage}
